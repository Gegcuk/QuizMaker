# Database Configuration
DB_USERNAME=quizmaker_user
DB_PASSWORD=secure_password_here
DB_ROOT_PASSWORD=secure_root_password_here

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_at_least_256_bits_long

# Security Peppers (use strong random values)
TOKEN_PEPPER_SECRET=your_strong_random_token_pepper_value
RESET_TOKEN_PEPPER=your_strong_random_reset_token_pepper
VERIFICATION_TOKEN_PEPPER=your_strong_random_verification_token_pepper

# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
STRIPE_PRICE_SMALL=price_your_small_price_id
STRIPE_PRICE_MEDIUM=price_your_medium_price_id
STRIPE_PRICE_LARGE=price_your_large_price_id
STRIPE_PRICE_SUBSCRIPTION=price_your_subscription_price_id

# Email Provider Configuration
APP_EMAIL_PROVIDER=ses
APP_EMAIL_FROM=noreply@quizzence.com
APP_EMAIL_REGION=us-east-1
APP_EMAIL_SES_CONFIGURATION_SET=quizzence-prod

# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Legacy SMTP Configuration (unused when APP_EMAIL_PROVIDER=ses)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Frontend Configuration
FRONTEND_BASE_URL=https://quizzence.com

# Billing Configuration
# Positive base-10 integer. The deployment fallback is the same canonical value: 1000.
BILLING_TOKEN_TO_LLM_RATIO=1000
# Customer-facing quiz-generation tariff. It exactly matches the frontend
# estimator: ceil(0.35 * sourceCharacters / 1000) * activeQuestionTypes + 3.
BILLING_GENERATION_TARIFF_VERSION=v1-content-length-per-question-type
BILLING_GENERATION_BASE_TOKENS=3
BILLING_GENERATION_TOKENS_PER_THOUSAND_CHARACTERS=0.35
BILLING_RESERVATION_TTL_MINUTES=120
BILLING_SAFETY_FACTOR=1.2
BILLING_CURRENCY=usd

# Isolated document parser process limits
# Global and per-user child-process capacity plus the wall-clock conversion budget.
DOCUMENT_MAX_CONCURRENT_PARSES=2
DOCUMENT_MAX_CONCURRENT_PARSES_PER_USER=1
DOCUMENT_PARSE_TIMEOUT=PT60S
# Maximum heap per parser child JVM (384 MiB) and maximum response protocol size (16 MiB).
DOCUMENT_PARSER_WORKER_MAX_HEAP_BYTES=402653184
DOCUMENT_PARSER_WORKER_MAX_OUTPUT_BYTES=16777216
# Positive ISO-8601 durations for graceful TERM, forced-kill confirmation, and service shutdown.
DOCUMENT_PARSER_TERMINATION_GRACE=PT1S
DOCUMENT_PARSER_FORCE_KILL_TIMEOUT=PT5S
DOCUMENT_PARSER_SHUTDOWN_TIMEOUT=PT10S
# Positive retention for private crash-leftover parser workspaces.
DOCUMENT_STAGING_RETENTION=PT24H

# DigitalOcean Spaces / CDN
MEDIA_BUCKET=quizzence
MEDIA_REGION=lon1
MEDIA_ENDPOINT=https://lon1.digitaloceanspaces.com
MEDIA_CDN_BASE_URL=https://cdn.quizzence.com
DO_SPACES_ACCESS_KEY=your_spaces_access_key_here
DO_SPACES_SECRET_KEY=your_spaces_secret_key_here
MEDIA_UPLOAD_URL_TTL=PT15M
MEDIA_MAX_IMAGE_SIZE_BYTES=20971520
MEDIA_MAX_DOC_SIZE_BYTES=20971520
MEDIA_DELETE_REMOTE=false
MEDIA_ARTICLE_PREFIX=articles
MEDIA_LIBRARY_PREFIX=library
