# Production Configuration Example
# Copy this file to application-prod.properties and update with your actual values

# Database Configuration
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}

# Disable SQL logging in production
spring.jpa.show-sql=false
logging.level.org.hibernate.SQL=WARN
logging.level.org.springframework=INFO
logging.level.uk.gegc.quizmaker=INFO

# JWT Configuration
jwt.secret=${JWT_SECRET}
jwt.access-expiration-ms=43200000
jwt.refresh-expiration-ms=604800000

# OpenAI Configuration
spring.ai.openai.api-key=${OPENAI_API_KEY}
spring.ai.openai.chat.options.model=${OPENAI_MODEL:gpt-5.6-luna}
spring.ai.openai.chat.options.temperature=${OPENAI_TEMPERATURE:1.0}
spring.ai.openai.chat.options.max-completion-tokens=${OPENAI_MAX_COMPLETION_TOKENS:16000}
spring.http.client.factory=jdk
spring.http.client.connect-timeout=${AI_PROVIDER_CONNECT_TIMEOUT:10s}
spring.http.client.read-timeout=${AI_PROVIDER_READ_TIMEOUT:180s}

# Bound all nested retries for one chunk/question-type generation task.
spring.ai.retry.max-attempts=1
ai.rate-limit.max-attempts-per-task=5

# CORS Configuration for Production
# IMPORTANT: Replace with your actual production domain(s)
# NEVER use wildcards (*) or allow all origins in production
app.cors.allowed-origins=https://quizmaker.yourdomain.com,https://www.quizmaker.yourdomain.com
# Never use origin patterns in production
app.cors.use-origin-patterns=false
app.cors.allowed-methods=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
app.cors.allowed-headers=Authorization,Content-Type,Accept,X-Requested-With,Origin,If-None-Match,Accept-Language
app.cors.exposed-headers=Location,Link,Content-Disposition,X-Total-Count,X-RateLimit-Limit,X-RateLimit-Remaining,X-RateLimit-Reset
# Set to false if only using JWT in Authorization header (no cookies)
app.cors.allow-credentials=true
app.cors.max-age=3600

# File Upload Configuration
spring.servlet.multipart.max-file-size=150MB
spring.servlet.multipart.max-request-size=150MB

# Thread Pool Configuration
async.ai.core-pool-size=8
async.ai.max-pool-size=16
async.ai.queue-capacity=100
async.ai.keep-alive-seconds=60

# Keep provider concurrency conservative until production latency and 429 data
# justify a measured increase. Queue saturation fails closed; tasks never run on callers.
async.ai.provider.core-pool-size=8
async.ai.provider.max-pool-size=16
async.ai.provider.queue-capacity=50
async.ai.provider.keep-alive-seconds=60
async.ai.provider.await-termination-seconds=30

async.general.core-pool-size=4
async.general.max-pool-size=8
async.general.queue-capacity=50
async.general.keep-alive-seconds=60

# Flyway enabled in production
spring.flyway.enabled=true

# Default quiz category used when clients omit or send invalid category IDs
quiz.default-category-id=${QUIZ_DEFAULT_CATEGORY_ID:00000000-0000-0000-0000-000000000001}

# Quiz import defaults
quiz.import.max-items=${QUIZ_IMPORT_MAX_ITEMS:1000}
quiz.import.rate-limit-per-minute=${QUIZ_IMPORT_RATE_LIMIT_PER_MINUTE:10}

# Feature flags (off by default in prod unless explicitly enabled)
quizmaker.features.share-links=false
quizmaker.features.organizations=false

# Share Links security
quizmaker.share-links.token-pepper=${TOKEN_PEPPER_SECRET}
